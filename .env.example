# Same Supabase project as complex-recruitment-admin.

# Public, read-only use (public_jobs view). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Used exclusively by lib/supabase/admin.ts for trusted public-form
# intake (API route handlers). Never prefix with NEXT_PUBLIC_, never import from a
# Client Component.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile — required on every public write endpoint (see
# lib/server/turnstile.ts, components/turnstile/PublicTurnstile.tsx).
# Site key is safe to expose to the browser; the secret key is SERVER ONLY.
# In production, if TURNSTILE_SECRET_KEY is unset, submissions fail closed
# (rejected) rather than silently skipping verification. Outside production,
# an unset secret skips verification so local/preview dev doesn't need real keys.
# For local testing, Cloudflare publishes dummy keys that always pass/fail —
# see https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# REQUIRED in real production (Vercel's Production environment specifically —
# see isProductionEnvironment() in lib/server/environment.ts; Preview builds
# are exempt since their hostname changes per branch/PR). Comma-separated list
# of hostnames Turnstile is allowed to report for a solved challenge. Add the
# eventual custom production domain here later — no code change needed.
# Currently tested production hostname:
# TURNSTILE_ALLOWED_HOSTNAMES=complex-recruitment-website-sage.vercel.app
TURNSTILE_ALLOWED_HOSTNAMES=

# Rate limiting (lib/server/rate-limit.ts). Keyed HMAC secret used to hash the
# caller's IP before it is stored — never store or log the raw IP. SERVER ONLY.
# REQUIRED in real production: if unset there, requests fail closed (503-style,
# safe generic message) rather than silently running without a rate limiter.
# Outside production, an unset secret skips rate limiting (logged loudly) so
# local/preview dev doesn't need it configured.
RATE_LIMIT_HASH_SECRET=

# Protects the orphan CV cleanup cron route (app/api/cron/cleanup-orphan-cvs,
# scheduled in vercel.json). SERVER ONLY. Vercel Cron sends this automatically
# as `Authorization: Bearer <value>` once the env var is set — see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=
