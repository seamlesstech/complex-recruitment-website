# Same Supabase project as complex-recruitment-admin.

# Public, read-only use (public_jobs view). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Used exclusively by lib/supabase/admin.ts for trusted public-form
# intake (API route handlers). Never prefix with NEXT_PUBLIC_, never import from a
# Client Component.
SUPABASE_SECRET_KEY=
